# 正式服模板：复制到 /etc/ai-xing/mcp.env；MCP 不会读取项目根目录 .env。
# Supabase 公共连接配置；禁止填写 Service Role / Secret Key、Access Token 或数据库密码。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# 生产环境固定为 loopback；非生产诊断如需公网绑定必须显式设置危险开关，生产会拒绝。
NODE_ENV=production
MCP_ALLOW_NON_LOOPBACK=false

# MCP 服务只监听服务器内网回环地址
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_ALLOWED_HOSTS=MCP_ALLOWED_HOSTS=remix.btitib.com,127.0.0.1,localhost   #MCP的地址
MCP_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1,::ffff:127.0.0.1

# 会话、安全和查询限制
MCP_SESSION_TTL_MS=28800000
MCP_REFRESH_WINDOW_MS=60000
MCP_REQUEST_TIMEOUT_MS=15000
MCP_READINESS_TTL_MS=5000
MCP_CONFIRMATION_TTL_MS=600000
MCP_ENABLE_JSON_RESPONSE=true
MCP_SSE_KEEP_ALIVE_MS=15000
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=30
MCP_INITIALIZE_RATE_LIMIT_MAX=30
MCP_READ_RATE_LIMIT_MAX=60
MCP_WRITE_RATE_LIMIT_MAX=20
MCP_DRAIN_TIMEOUT_MS=10000

# 生产环境必须由 Nginx 设置 X-Forwarded-Proto=https
MCP_REQUIRE_HTTPS=true
